---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteProjet from '../components/CarteProjet.astro';
import { traduire, route, trier, champ, autreLangue } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const projets = trier(await getCollection('projets')).slice(0, 4);

const h = r.hero;
---

<Base titre={champ(h, 'eyebrow', langue)} description={champ(h, 'chapeau', langue)} equivalent={route(autreLangue(langue), 'accueil')}>
    {r.banniere.visible && r.banniere.image && (
      <section class="enveloppe banniere reveal reveal--bloc">
        {r.banniere.lien ? (
          <a href={r.banniere.lien}><img src={r.banniere.image} alt="" /></a>
        ) : (
          <img src={r.banniere.image} alt="" />
        )}
      </section>
    )}

    <div class="hero-scene">
      <canvas class="fumee" aria-hidden="true"></canvas>
      <section class="enveloppe hero">
        <p class="eyebrow reveal reveal--eyebrow">{champ(h, 'eyebrow', langue)}</p>
        <h1 class="hero-titre titre-masque reveal">
          <span class="ligne"><span>{champ(h, 'titre1', langue)}</span></span>
          <span class="ligne"><span>{champ(h, 'titre2', langue)} <em>{champ(h, 'titre3', langue)}</em></span></span>
        </h1>
        <p class="chapeau reveal reveal--eyebrow">{champ(h, 'chapeau', langue)}</p>
      </section>
    </div>

    {r.sections.filter((s) => s.visible).map((s) => {
      if (s.cle === 'selection') return (
        <section class="enveloppe bloc">
          <div class="entete-bloc reveal reveal--bloc">
            <p class="eyebrow">{t('accueil.selection')}</p>
            <a class="lien-accent" href={route(langue, 'projets')}>{t('accueil.tout')} &rarr;</a>
          </div>
          <ul class="grille">
            {projets.map((projet) => <CarteProjet projet={projet} langue={langue} />)}
          </ul>
        </section>
      );
      if (s.cle === 'duo') return (
        <section class="enveloppe bloc">
          <p class="eyebrow reveal reveal--bloc">{t('accueil.lignes')}</p>
          <div class="duo reveal reveal--bloc">
            <article>
              <h2>{t('accueil.ligneA.titre')}</h2>
              <p class="chapeau">{t('accueil.ligneA.texte')}</p>
            </article>
            <article>
              <h2>{t('accueil.ligneB.titre')}</h2>
              <p class="chapeau">{t('accueil.ligneB.texte')}</p>
            </article>
          </div>
        </section>
      );
      if (s.cle === 'cta') return (
        <section class="enveloppe cta">
          <h2 class="reveal reveal--cta">{champ(h, 'cta_titre', langue)}</h2>
          <p class="chapeau reveal reveal--cta">{champ(h, 'cta_texte', langue)}</p>
          <a class="bouton bouton--plein reveal reveal--cta" href={route(langue, 'contact')}>{champ(h, 'cta_bouton', langue)}</a>
        </section>
      );
      return null;
    })}
</Base>

<style>
  .banniere { padding-top: 1.5rem; }
  .banniere img { width: 100%; border: 1px solid var(--bordure); }
  .banniere a { display: block; }
  .hero-scene { position: relative; isolation: isolate; }
  .fumee {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--courbe);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .fumee.active { opacity: 1; }
  .hero {
    display: grid;
    gap: 2rem;
    justify-items: start;
    padding-block: clamp(4rem, 9vw, 8.75rem) clamp(3rem, 5vw, 5rem);
  }
  .bloc { padding-block: 0 var(--section); }
  .entete-bloc {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .entete-bloc a { font-size: var(--t-legende); }
  .duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    border-top: 1px solid var(--bordure);
    margin-top: 2rem;
    padding-top: 2.5rem;
  }
  .duo h2 { margin-bottom: 1rem; }
  .cta {
    display: grid;
    gap: 1rem;
    justify-items: start;
    border-top: 1px solid var(--bordure);
    padding-top: 3rem;
  }
  .cta .bouton { margin-top: 0.5rem; }
</style>

<script>
  import { lancerFumee } from '../scripts/fumee.js';
  lancerFumee(document.querySelector('.fumee'));
</script>
