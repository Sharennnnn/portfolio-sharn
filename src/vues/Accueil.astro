---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteProjet from '../components/CarteProjet.astro';
import { traduire, route, trier, champ, rempli, autreLangue, urlProjet } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';
import { personne } from '../lib/schema.js';
import { srcsetVignette, couleurAttente, dimensions } from '../lib/images.js';
import { sectionsAccueil } from '../lib/sections-accueil.js';
// Serif italique du titre : utilisée sur cette page seulement, donc préchargée ici seulement.
import policeSerif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const schema = { '@context': 'https://schema.org', ...personne(r, t('schema.metier'), Astro.site) };
// Sélection : les projets cochés « phare » (4 premiers selon l'ordre), sinon les 4 premiers tout court.
const tous = trier(await getCollection('projets'));
const phares = tous.filter((p) => p.data.phare);
const projets = (phares.length ? phares : tous).slice(0, 4);

// Mur d'affiches du hero : 12 projets hors sélection (sinon les mêmes affiches s'affichent deux fois de suite).
const mur = await Promise.all(
  tous.filter((p) => !projets.includes(p)).slice(0, 12).map(async (p) => ({
    id: p.id,
    src: p.data.couverture,
    srcset: await srcsetVignette(p.data.couverture),
    couleur: await couleurAttente(p.data.couverture),
  }))
);
const colonnes = [mur.filter((_, i) => i % 2 === 0), mur.filter((_, i) => i % 2 === 1)];

const h = r.hero;
const deuxChiffres = (n) => String(n).padStart(2, '0');
const mots = t('accueil.mots').split('|');

const virgules = (texte) => (texte || '').split(',').map((x) => x.trim()).filter(Boolean);

// Titre d'une rubrique : celui de l'admin, sinon celui de ui.js.
const rubrique = (cle, nom) => (r.rubriques[cle] && champ(r.rubriques[cle], nom, langue)) || t(`accueil.${cle}.${nom}`);

const services = r.services.map((s) => ({
  titre: champ(s, 'titre', langue),
  texte: champ(s, 'texte', langue),
  etiquettes: virgules(champ(s, 'etiquettes', langue)),
}));

// Boîte à outils : chaque outil avec le nombre de fiches projet qui le citent.
const nbProjets = (outil) => tous.filter((p) => p.data.outils.some((o) => o.trim().toLowerCase() === outil.toLowerCase())).length;
const outils = r.boite_outils.map((g) => ({
  groupe: champ(g, 'groupe', langue),
  outils: g.outils.map((o) => o.trim()).filter(Boolean).map((nom) => ({ nom, n: nbProjets(nom) })),
}));
const projetsCites = (n) => (n === 1 ? t('accueil.outils.un') : t('accueil.outils.n').replace('{n}', String(n)));

// Parcours : la première année de la période sert de grand chiffre ; la frise suit l'ordre chronologique
// (tri stable : à année égale, l'ordre de l'admin est gardé).
const parcours = [...r.apropos.parcours].sort((a, b) => (a.periode.match(/\d{4}/)?.[0] ?? '').localeCompare(b.periode.match(/\d{4}/)?.[0] ?? '')).map((p) => ({
  annee: p.periode.match(/\d{4}/)?.[0] ?? p.periode,
  periode: p.periode,
  titre: champ(p, 'titre', langue),
  lieu: champ(p, 'lieu', langue),
}));

// À propos : le premier paragraphe de la bio devient l'énoncé qui s'allume au scroll, mot à mot.
const bio = champ(r.apropos, 'bio', langue);
const motsEnonce = (bio[0] || '').split(' ');
const portrait = r.apropos.photo ? { src: r.apropos.photo, ...(await dimensions(r.apropos.photo)), srcset: await srcsetVignette(r.apropos.photo) } : null;

// Bandeau : les disciplines et étiquettes des services, répétées pour remplir l'écran.
const bandeau = [services.map((s) => s.titre), services.flatMap((s) => s.etiquettes)].filter((l) => l.length);

// Réalisé pour : les fiches avec un client, puis les lignes du parcours qui ne sont pas une école.
// shortcut: repère ces lignes par leur lieu, à revoir si l'admin gagne un champ dédié.
const realise = [
  ...tous.filter((p) => rempli(p.data.client)).map((p) => ({ nom: p.data.client, detail: champ(p.data, 'titre', langue), url: urlProjet(langue, p.id) })),
  ...r.apropos.parcours.filter((p) => /client|télétravail|remote/i.test(p.lieu)).map((p) => ({ nom: champ(p, 'titre', langue), detail: p.periode })),
];

// Index : tous les projets, regroupés par origine.
const index = await Promise.all(['client', 'fanart', 'exercice', 'perso'].map(async (origine) => ({
  origine,
  projets: await Promise.all(tous.filter((p) => p.data.origine === origine).map(async (p) => ({
    titre: champ(p.data, 'titre', langue),
    annee: p.data.annee,
    url: urlProjet(langue, p.id),
    src: p.data.couverture,
    srcset: await srcsetVignette(p.data.couverture),
  }))),
})));
const groupes = index.filter((g) => g.projets.length);
const premier = groupes[0]?.projets[0];
---

<Base titre={champ(h, 'eyebrow', langue)} preloads={[policeSerif]} description={champ(h, 'chapeau', langue)} equivalent={route(autreLangue(langue), 'accueil')} schema={schema}>
    {/* Le fil conducteur : décor qui suit le scroll ; les titres des sections restent la vraie structure. */}
    <div class="fil" aria-hidden="true">
      <span class="fil-trait"></span>
      <span class="fil-tete"></span>
      <span class="fil-libelle"></span>
    </div>

    <div class="hero-scene" data-fil="">
      <canvas class="fumee" aria-hidden="true"></canvas>
      <section class="enveloppe hero">
        <div class="hero-texte">
          <p class="eyebrow reveal reveal--eyebrow"><span class="pastille" aria-hidden="true"></span>{champ(h, 'eyebrow', langue)}</p>
          <h1 class="hero-titre titre-masque reveal">
            {/* {' '} : espace entre les lignes pour Google et les lecteurs d'écran (invisible en flex). */}
            <span class="ligne"><span>{champ(h, 'titre1', langue)}</span></span>{' '}
            <span class="ligne"><span>{champ(h, 'titre2', langue)}</span></span>{' '}
            <span class="ligne ligne-chute"><span><em>{champ(h, 'titre3', langue)}</em></span></span>
          </h1>
          {/* Mot qui change : les lecteurs d'écran lisent la liste entière une seule fois. */}
          <p class="mots reveal reveal--eyebrow">
            <span class="sr-only">{t('accueil.mots.intro')}{langue === 'fr' ? ' : ' : ': '}{mots.join(', ')}.</span>
            <span class="mots-intro" aria-hidden="true">{t('accueil.mots.intro')}</span>
            <span class="mots-fenetre" aria-hidden="true">
              {/* Le premier mot est répété à la fin pour que la boucle reparte sans saut. */}
              <span class="mots-piste">{[...mots, mots[0]].map((m) => <em>{m}</em>)}</span>
            </span>
          </p>
          <p class="chapeau reveal reveal--eyebrow">{champ(h, 'chapeau', langue)}</p>
          <div class="actions reveal reveal--eyebrow">
            <a class="bouton bouton--plein" href={route(langue, 'projets')}>{t('accueil.tout')} <span class="fleche" aria-hidden="true">&rarr;</span></a>
            <a class="lien-accent" href={route(langue, 'contact')}>{champ(h, 'cta_bouton', langue)}</a>
          </div>
        </div>

        {/* Décor : les mêmes projets sont accessibles dans la sélection et sur la page Projets. */}
        <div class="mur" aria-hidden="true">
          {colonnes.map((col, c) => (
            <div class="colonne">
              <div class:list={['piste defile', { inverse: c === 1 }]}>
                {[...col, ...col].map((a, i) => (
                  <a href={urlProjet(langue, a.id)} tabindex="-1">
                    <img src={a.src} srcset={a.srcset} sizes="(max-width: 48rem) min(58vw, 16rem), 15rem" style={`background:${a.couleur}`} alt="" width="900" height="1200" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={c === 0 && i === 0 ? 'high' : undefined} decoding="async" />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
        {/* WCAG 2.2.2 : tout ce qui bouge seul plus de 5 s doit pouvoir être arrêté (mur, fumée, pastille).
            Caché sans JavaScript (il ne ferait rien) et quand les animations sont déjà réduites. */}
        <button class="pause-anim" type="button" hidden data-pause={t('a11y.pause')} data-lecture={t('a11y.lecture')}>
          <span class="icone" aria-hidden="true"></span><span class="libelle sr-only">{t('a11y.pause')}</span>
        </button>
      </section>
    </div>

    {sectionsAccueil(r.sections.filter((s) => s.visible).map((s) => s.cle)).map((cle) => {
      const s = { cle };
      if (s.cle === 'bandeau' && bandeau.length) return (
        <div class="bandeau" aria-hidden="true" data-fil="">
          {bandeau.map((ligne, i) => (
            <p class:list={['bandeau-ligne', { 'bandeau-ligne--chute': i === 1 }]}>
              {Array.from({ length: 6 }, () => ligne).flat().map((m) => <span>{m}</span>)}
            </p>
          ))}
        </div>
      );
      if (s.cle === 'apropos' && motsEnonce[0]) return (
        <section class="enveloppe bloc apropos" data-fil={t('accueil.fil.apropos')}>
          {portrait && (
            <div class="apropos-photo">
              <img src={portrait.src} srcset={portrait.srcset} sizes="(max-width: 48rem) 60vw, 26rem" alt={t('apropos.photo')} width={portrait.width} height={portrait.height} loading="lazy" decoding="async" />
            </div>
          )}
          <div class="apropos-texte">
            <h2 class="titre-chapitre reveal reveal--bloc">{t('accueil.apropos.titre')} <em>{t('accueil.apropos.chute')}</em></h2>
            <p class="enonce">
              {motsEnonce.map((m, i) => <><span class="m" style={`--p:${(i / motsEnonce.length).toFixed(3)}`}>{m}</span>{' '}</>)}
            </p>
            {bio.slice(1).map((p) => <p class="apropos-suite reveal reveal--bloc">{p}</p>)}
            <a class="lien-accent reveal reveal--bloc" href={route(langue, 'apropos')}>{t('accueil.apropos.suite')} &rarr;</a>
          </div>
        </section>
      );
      if (s.cle === 'realise' && realise.length) return (
        <section class="chapitre chapitre--papier" data-fil={t('accueil.fil.realise')}>
          <div class="enveloppe">
            <div class="entete-chapitre reveal reveal--bloc">
              <p class="eyebrow">{t('accueil.realise.surtitre')}</p>
              <h2 class="titre-chapitre">{t('accueil.realise.titre')} <em>{t('accueil.realise.chute')}</em></h2>
            </div>
            <ul class="realise">
              {realise.map((x) => (
                <li>
                  {x.url ? <a href={x.url}><span class="realise-nom">{x.nom}</span><span class="realise-detail">{x.detail} <span aria-hidden="true">&rarr;</span></span></a>
                    : <div><span class="realise-nom">{x.nom}</span><span class="realise-detail">{x.detail}</span></div>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
      if (s.cle === 'index' && groupes.length) return (
        <section class="chapitre" data-fil={t('accueil.fil.index')}>
          <div class="enveloppe">
            <div class="entete-chapitre reveal reveal--bloc">
              <p class="eyebrow">{t('accueil.index.surtitre')}</p>
              <h2 class="titre-chapitre">{t('accueil.index.titre')} <em>{t('accueil.index.chute')}</em></h2>
            </div>
            <div class="index">
              <div class="index-groupes">
                {groupes.map((g) => (
                  <section>
                    <h3 class="index-origine">{t(`origine.${g.origine}`)} <span>{deuxChiffres(g.projets.length)}</span></h3>
                    <ul>
                      {g.projets.map((p) => (
                        <li><a href={p.url} data-src={p.src} data-srcset={p.srcset}><span>{p.titre}</span><span class="index-annee">{p.annee}</span></a></li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
              {/* Aperçu au survol, souris et clavier : les liens de gauche suffisent sans lui. */}
              <div class="index-apercu" aria-hidden="true">
                <img src={premier.src} srcset={premier.srcset} sizes="24rem" alt="" width="900" height="1200" loading="lazy" decoding="async" />
              </div>
            </div>
          </div>
        </section>
      );
      if (s.cle === 'selection') return (
        <section class="enveloppe bloc" data-fil={t('accueil.fil.selection')}>
          <div class="entete-bloc reveal reveal--bloc">
            <h2>{t('accueil.selection')}</h2>
            <a class="lien-accent" href={route(langue, 'projets')}>{t('accueil.tout')} &rarr;</a>
          </div>
          <ul class="grille selection">
            {projets.map((projet, i) => (
              <CarteProjet projet={projet} langue={langue} numero={deuxChiffres(i + 1)} tailles={i === 0 ? '(max-width: 40rem) 100vw, 660px' : '(max-width: 40rem) 50vw, 320px'} />
            ))}
            <li class="tuile-tout reveal reveal--carte">
              <a href={route(langue, 'projets')}>
                <span class="tuile-nombre">{deuxChiffres(tous.length)}</span>
                <span class="tuile-texte">{t('accueil.nombre').replace('{n}', String(tous.length))} <span aria-hidden="true">&rarr;</span></span>
              </a>
            </li>
          </ul>
        </section>
      );
      if (s.cle === 'duo') return (
        <section class="enveloppe bloc">
          <p class="eyebrow reveal reveal--bloc">{t('accueil.lignes')}</p>
          <div class="duo">
            {['A', 'B', 'C'].map((x) => (
              <article class="reveal reveal--bloc">
                <span class="lettre" aria-hidden="true">{x}</span>
                <h2>{t(`accueil.ligne${x}.titre`)}</h2>
                <p class="chapeau">{t(`accueil.ligne${x}.texte`)}</p>
              </article>
            ))}
          </div>
        </section>
      );
      if (s.cle === 'services' && services.length) return (
        <section class="chapitre chapitre--papier" data-fil={t('accueil.fil.services')}>
          <div class="enveloppe">
            <div class="entete-chapitre reveal reveal--bloc">
              <p class="eyebrow">{rubrique('services', 'surtitre')}</p>
              <h2 class="titre-chapitre">{rubrique('services', 'titre')} <em>{rubrique('services', 'chute')}</em></h2>
            </div>
            <ol class="services">
              {services.map((x, i) => (
                <li class="reveal reveal--bloc">
                  <span class="services-numero" aria-hidden="true">{deuxChiffres(i + 1)}</span>
                  <h3>{x.titre}</h3>
                  <div class="services-detail">
                    <p>{x.texte}</p>
                    {x.etiquettes.length > 0 && <ul class="etiquettes">{x.etiquettes.map((e) => <li>{e}</li>)}</ul>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
      if (s.cle === 'outils' && outils.length) return (
        <section class="chapitre chapitre--accent" data-fil={t('accueil.fil.outils')}>
          <div class="enveloppe">
            <div class="entete-chapitre reveal reveal--bloc">
              <p class="eyebrow">{rubrique('outils', 'surtitre')}</p>
              <h2 class="titre-chapitre">{rubrique('outils', 'titre')} <em>{rubrique('outils', 'chute')}</em></h2>
            </div>
            <dl class="outils">
              {outils.map((g) => (
                <div class="reveal reveal--bloc">
                  <dt>{g.groupe}</dt>
                  <dd>
                    <ul class="etiquettes">
                      {g.outils.map((o, i) => <li style={`--i:${i}`}>{o.nom}{o.n > 0 && <span class="outil-nombre"> · {projetsCites(o.n)}</span>}</li>)}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      );
      if (s.cle === 'parcours' && parcours.length) return (
        <section class="chapitre chapitre--frise" style={`--n:${parcours.length}`} data-fil={t('accueil.fil.parcours')}>
          <div class="frise-collant">
            <div class="enveloppe entete-chapitre reveal reveal--bloc">
              <p class="eyebrow">{rubrique('parcours', 'surtitre')}</p>
              <h2 class="titre-chapitre">{rubrique('parcours', 'titre')} <em>{rubrique('parcours', 'chute')}</em></h2>
            </div>
            <ol class="frise">
              {parcours.map((p) => (
                <li>
                  <span class="frise-annee" aria-hidden="true">{p.annee}</span>
                  <p class="frise-periode">{p.periode}</p>
                  <h3>{p.titre}</h3>
                  {rempli(p.lieu) && <p class="etiquettes"><span>{p.lieu}</span></p>}
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
      if (s.cle === 'cta') return (
        <section class="cta" data-fil={t('accueil.fil.cta')}>
          <div class="enveloppe cta-interne">
            <h2 class="cta-titre titre-masque reveal"><span class="ligne"><span>{champ(h, 'cta_titre', langue)}</span></span></h2>
            <div class="cta-bas reveal reveal--cta">
              <p class="chapeau">{champ(h, 'cta_texte', langue)}</p>
              <a class="bouton bouton--plein" href={route(langue, 'contact')}>{champ(h, 'cta_bouton', langue)} <span class="fleche" aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
        </section>
      );
      return null;
    })}
</Base>

<style>
  /* ---------- Fil conducteur : une ligne qui se trace du haut au bas de la page ---------- */
  .fil { display: none; }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .fil {
        --fil: var(--accent);
        --x: clamp(0.4rem, 1.2vw, 1.25rem);
        display: block;
        position: fixed;
        inset: 0 auto 0 0;
        z-index: calc(var(--z-entete) - 1);
        pointer-events: none;
      }
      /* Sur les fonds colorés, la couleur du fil suit celle du texte du chapitre. */
      .fil[data-fond='papier'] { --fil: #9a4a0b; }
      .fil[data-fond='accent'] { --fil: var(--fond); }
      .fil-trait, .fil-tete { position: absolute; top: 0; background: var(--fil); transition: background-color 400ms var(--courbe); }
      .fil-trait { left: var(--x); width: 2px; height: 100svh; transform-origin: top; animation: fil-trace linear both; }
      .fil-tete { left: calc(var(--x) - 4px); width: 10px; height: 10px; margin-top: -5px; border-radius: 50%; animation: fil-tete linear both; }
      /* Règles séparées : le minifieur fusionnerait sinon la timeline dans le raccourci « animation ». */
      span.fil-trait, span.fil-tete { animation-timeline: scroll(root); }
    }
  }
  @keyframes fil-trace { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes fil-tete { from { translate: 0 0; } to { translate: 0 100svh; } }
  .fil-libelle { display: none; }
  /* Le nom de la section en cours, dans la marge : seulement là où la marge peut le contenir. */
  @media (min-width: 64rem) {
    .fil-libelle {
      display: block;
      position: absolute;
      bottom: 1.5rem;
      left: calc(var(--x) + 0.6rem);
      writing-mode: vertical-rl;
      rotate: 180deg;
      font-size: var(--t-eyebrow);
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--fil);
      transition: color 400ms var(--courbe);
    }
  }

  /* ---------- Hero ---------- */
  /* overflow-x : le mur incliné et agrandi dépasse du bord droit sur les écrans moyens. */
  .hero-scene { position: relative; isolation: isolate; overflow-x: clip; }
  .fumee {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--courbe);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }
  .fumee.active { opacity: 1; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 6rem);
    min-height: min(calc(100svh - 4rem), 52rem);
  }
  .hero-texte {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  /* Titre limité aussi par la hauteur de l'écran : le bouton principal reste visible à l'arrivée sur un portable. */
  .hero-titre { font-size: min(var(--t-hero), max(3.25rem, 11svh)); }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.6rem; }
  /* Pastille « disponible » : pulsation lente, arrêtée si les animations sont réduites. */
  .pastille {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: pulsation 2.4s var(--courbe) infinite;
  }
  @keyframes pulsation {
    70% { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  /* Mot qui change : petit surtitre puis un mot en serif italique qui monte toutes les 3 s. */
  .mots {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin: -0.75rem 0 0;
  }
  .mots-intro {
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--texte-doux);
  }
  .mots-fenetre {
    display: inline-block;
    height: 1.2em;
    overflow: hidden;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.2;
    color: var(--accent);
  }
  .mots-piste { display: flex; flex-direction: column; animation: mots 9s var(--courbe) infinite; }
  .mots-piste em { font-style: italic; }
  .mots-fenetre:hover .mots-piste,
  .en-pause .mots-piste { animation-play-state: paused; }
  /* 4 mots (le premier répété) : chaque palier = 25 % de la piste. */
  @keyframes mots {
    0%, 28% { translate: 0 0; }
    33%, 61% { translate: 0 -25%; }
    66%, 94% { translate: 0 -50%; }
    100% { translate: 0 -75%; }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    font-size: var(--t-legende);
    font-weight: 500;
  }

  /* Mur d'affiches : deux colonnes qui défilent en sens inverse, légèrement inclinées. */
  .mur {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: min(calc(100svh - 9rem), 44rem);
    overflow: hidden;
    rotate: -5deg;
    scale: 1.08;
  }
  /* Fondu haut et bas par des voiles au lieu d'un mask-image : le masque obligeait à repeindre
     tout le mur à chaque image de l'animation. */
  .mur::before,
  .mur::after {
    content: '';
    position: absolute;
    inset-inline: -10%;
    height: 16%;
    z-index: 1;
    pointer-events: none;
  }
  .mur::before { top: 0; background: linear-gradient(var(--fond), transparent); }
  .mur::after { bottom: 0; background: linear-gradient(transparent, var(--fond)); }
  .colonne { overflow: hidden; }
  .piste {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    /* Le padding égal à l'écart rend la boucle exacte : -50 % = une série complète. */
    padding-bottom: 1rem;
    animation: defile-y 70s linear infinite;
    will-change: transform;
  }
  .mur.hors-champ .piste { animation-play-state: paused; }
  .piste.inverse { animation-direction: reverse; animation-duration: 85s; }
  /* Pause au survol pour la souris seulement : sur iPhone, un toucher laisse :hover « collé »
     et le défilement resterait arrêté. */
  @media (hover: hover) and (pointer: fine) {
    .mur:hover .piste { animation-play-state: paused; }
  }
  .piste a {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--bordure);
    background: var(--surface);
  }
  .piste img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Assombri par l'opacité (sur fond sombre) plutôt qu'un filter, qui se repeint à chaque image. */
    opacity: 0.78;
    transition: opacity 600ms var(--courbe), transform 900ms var(--courbe-ressort);
  }
  .piste a:hover img { opacity: 1; transform: scale(1.05); }
  /* Sur fond clair, l'opacité délaverait les affiches au lieu de les assombrir. */
  :global([data-salle='allumee']) .piste img { opacity: 1; }
  @keyframes defile-y { to { transform: translateY(-50%); } }
  @keyframes defile-x { to { transform: translateX(-50%); } }

  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-bottom: 2rem; }
    /* Sur mobile : une seule bande horizontale sous le texte. */
    .mur {
      display: block;
      height: auto;
      rotate: none;
      scale: none;
      margin-inline: calc(-1 * var(--gouttiere));
    }
    .mur::before,
    .mur::after { inset-block: 0; inset-inline: auto; width: 10%; height: auto; }
    .mur::before { left: 0; background: linear-gradient(to right, var(--fond), transparent); }
    .mur::after { right: 0; background: linear-gradient(to left, var(--fond), transparent); }
    .colonne + .colonne { display: none; }
    .piste { flex-direction: row; width: max-content; padding: 0 0.75rem 0 0; gap: 0.75rem; animation-name: defile-x; animation-duration: 70s; }
    .piste a { width: min(58vw, 16rem); }
  }

  /* Le hero s'efface en montant, le mur glisse moins vite : on quitte l'affiche pour entrer dans la page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-texte { animation: hero-sortie linear both; }
      div.hero-texte { animation-timeline: view(); animation-range: exit 15% exit 100%; }
      .mur { animation: mur-sortie linear both; }
      div.mur { animation-timeline: view(); animation-range: exit 0% exit 100%; }
    }
  }
  @keyframes hero-sortie { to { opacity: 0; translate: 0 -4rem; } }
  @keyframes mur-sortie { to { translate: 0 3rem; } }

  /* ---------- Bandeau des disciplines : il coulisse au scroll, donc rien ne bouge tout seul ---------- */
  .bandeau { margin-top: clamp(1rem, 3vw, 3rem); overflow: clip; }
  .bandeau-ligne {
    display: flex;
    width: max-content;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    font-family: var(--police-titre);
    font-size: clamp(2.75rem, 8vw, 7.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bandeau-ligne--chute {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    text-transform: none;
    color: var(--accent);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bandeau-ligne { animation: bandeau linear both; }
      .bandeau-ligne--chute { animation-name: bandeau-inverse; }
      p.bandeau-ligne { animation-timeline: view(); }
    }
  }
  @keyframes bandeau { from { translate: 0 0; } to { translate: -30% 0; } }
  @keyframes bandeau-inverse { from { translate: -30% 0; } to { translate: 0 0; } }

  /* ---------- Sélection ---------- */
  .bloc { padding-block: var(--section) 0; }
  .entete-bloc {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .entete-bloc a { font-size: var(--t-legende); font-weight: 500; }
  /* Grille asymétrique : une grande affiche, trois petites et une tuile vers tout le catalogue. */
  @media (min-width: 40.0625rem) {
    .selection {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(1.5rem, 2.5vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
      align-items: start;
    }
    .selection > :global(:nth-child(1)) { grid-column: 1 / span 6; grid-row: span 2; }
    .selection > :global(:nth-child(2)) { grid-column: 7 / span 3; }
    .selection > :global(:nth-child(3)) { grid-column: 10 / span 3; }
    .selection > :global(:nth-child(4)) { grid-column: 7 / span 3; }
    .selection > :global(:nth-child(5)) { grid-column: 10 / span 3; }
    .selection > :global(:nth-child(1) .carte-titre) { font-size: var(--t-h3); margin-top: 1rem; }
  }
  @media (max-width: 40rem) {
    .selection > :global(:nth-child(1)) { grid-column: 1 / -1; }
  }
  /* Profondeur : au défilement, la grande affiche glisse moins que les petites, comme des plans
     à des distances différentes. CSS natif (animation-timeline) ; navigateur sans support : rien ne bouge. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 40.0625rem) {
      .selection > :global(.carte) { animation: profondeur linear both; }
      /* Règle séparée : le minifieur fusionnerait sinon la timeline dans le raccourci « animation », que Chrome rejette. */
      .selection > :global(li.carte) { animation-timeline: view(); }
      .selection > :global(.carte:nth-child(1)) { --profondeur: 1.5rem; }
      .selection > :global(.carte:nth-child(n + 2)) { --profondeur: 4rem; }
    }
  }
  @keyframes profondeur {
    from { translate: 0 var(--profondeur); }
    to { translate: 0 calc(-1 * var(--profondeur)); }
  }
  .tuile-tout a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--bordure-forte);
    overflow: hidden;
    isolation: isolate;
    transition: color var(--duree) var(--courbe), border-color var(--duree) var(--courbe);
  }
  .tuile-tout a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 600ms var(--courbe-ressort);
  }
  .tuile-tout a:hover,
  .tuile-tout a:focus-visible { color: var(--fond); border-color: var(--accent); }
  .tuile-tout a:hover::before,
  .tuile-tout a:focus-visible::before { transform: scaleY(1); }
  .tuile-nombre {
    font-family: var(--police-titre);
    font-size: clamp(4rem, 9vw, 7.5rem);
    line-height: 0.85;
  }
  .tuile-texte { font-size: var(--t-legende); font-weight: 600; }

  /* Les affiches se recalent à leur taille en entrant à l'écran. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .selection :global(.carte-visuel img:not(.survol)) { animation: affiche-entree linear both; }
      .selection :global(li .carte-visuel img:not(.survol)) { animation-timeline: view(); animation-range: entry 0% cover 45%; }
    }
  }
  @keyframes affiche-entree { from { scale: 1.14; } to { scale: 1; } }

  /* ---------- À propos ---------- */
  .apropos {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .apropos-photo { overflow: hidden; }
  .apropos-photo img { display: block; width: 100%; height: auto; }
  .apropos-texte { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); justify-items: start; }
  .enonce {
    margin: 0;
    font-size: clamp(1.5rem, 2.9vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: pretty;
    view-timeline: --enonce block;
    view-timeline-inset: 0;
  }
  .apropos-suite { margin: 0; max-width: 60ch; color: var(--texte-doux); }
  @media (max-width: 48rem) {
    .apropos { grid-template-columns: 1fr; }
    .apropos-photo { width: min(60vw, 18rem); }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Chaque mot s'allume à son tour : tout est lu quand l'énoncé atteint le milieu de l'écran. */
      .enonce .m { animation: mot-allume linear both; }
      p.enonce span.m {
        animation-timeline: --enonce;
        animation-range: cover calc(6% + var(--p) * 38%) cover calc(10% + var(--p) * 38%);
      }
      .apropos-photo { animation: photo-entree linear both; }
      div.apropos-photo { animation-timeline: view(); animation-range: entry 0% entry 80%; }
      .apropos-photo img { animation: photo-recul linear both; }
      div.apropos-photo img { animation-timeline: view(); }
    }
  }
  @keyframes mot-allume { from { opacity: 0.18; } to { opacity: 1; } }
  @keyframes photo-entree { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  @keyframes photo-recul { from { scale: 1.2; } to { scale: 1; } }

  /* ---------- Deux façons de travailler ---------- */
  .duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: clamp(2.5rem, 5vw, 5rem);
    margin-top: 1.5rem;
  }
  /* Sous-grille : lettres, titres et textes des trois colonnes partagent les mêmes rangées,
     donc les textes démarrent à la même hauteur même si un titre passe sur deux lignes. */
  .duo article {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 1.25rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--bordure);
  }
  /* Lettre pleine en gris de bordure (le contour de 1 px était presque invisible), accent au survol. */
  .lettre {
    font-family: var(--police-titre);
    font-size: clamp(5rem, 11vw, 9rem);
    line-height: 0.8;
    color: var(--bordure-forte);
    transition: color 600ms var(--courbe);
  }
  .duo h2 { align-self: end; }
  @media (hover: hover) and (pointer: fine) {
    .duo article:hover .lettre { color: var(--accent); }
  }

  /* ---------- Chapitres (services, outils, parcours) ---------- */
  /* Le fond change d'une rubrique à l'autre : papier crème, puis accent, puis retour au noir.
     Couleurs locales aux chapitres : --encre (texte), --encre-douce, --marque (numéros et étiquettes). */
  .chapitre {
    --encre: var(--texte);
    --encre-douce: var(--texte-doux);
    --marque: var(--accent);
    --fond-chapitre: var(--fond);
    margin-top: var(--section);
    padding-block: var(--section);
    background: var(--fond-chapitre);
    color: var(--encre);
  }
  .chapitre--papier {
    --encre: #16130f;
    --encre-douce: #57514a;
    /* Orange assombri : l'accent normal n'atteint pas 4,5:1 sur le crème. */
    --marque: #9a4a0b;
    --fond-chapitre: #efe8dc;
  }
  /* Fond = accent de l'admin : texte noir (≥ 8:1 avec l'accent par défaut). */
  .chapitre--accent {
    --encre: var(--fond);
    --encre-douce: color-mix(in srgb, var(--fond) 78%, var(--accent));
    --marque: var(--fond);
    --fond-chapitre: var(--accent);
    margin-top: 0;
  }
  /* Le mélange ci-dessus tombe à 4,14:1 sur l'accent foncé de la salle allumée. */
  :global([data-salle='allumee']) .chapitre--accent { --encre-douce: var(--fond); }
  /* Sélection inversée : les couleurs du chapitre échangées, lisibles sur les trois fonds. */
  .chapitre :global(::selection) { background: var(--encre); color: var(--fond-chapitre); }
  /* Deux chapitres qui se suivent se touchent : pas de bande de fond entre eux. */
  .chapitre + .chapitre { margin-top: 0; }
  .chapitre .eyebrow { color: var(--encre-douce); }
  .chapitre a { color: inherit; }

  .entete-chapitre { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .titre-chapitre { font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 0.95; text-wrap: balance; }
  .titre-chapitre em {
    display: block;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: var(--marque);
  }

  /* Étiquettes : petites capsules à bord fin, réutilisées par les trois rubriques. */
  .etiquettes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .etiquettes > * {
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--t-legende);
    font-weight: 500;
    color: var(--marque);
  }

  /* Services : numéro italique, nom, puis texte et étiquettes. */
  .services { overflow-x: clip; margin: 0; padding: 0; list-style: none; border-top: 1px solid color-mix(in srgb, var(--encre) 25%, transparent); }
  .services > li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.3fr);
    align-items: baseline;
    gap: 1rem clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 25%, transparent);
  }
  .services-numero { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1; color: var(--marque); }
  .services h3 { font-size: clamp(1.5rem, 2.6vw, 2.25rem); }
  .services-detail { display: grid; gap: 1rem; }
  .services-detail p { margin: 0; color: var(--encre-douce); max-width: 46ch; }
  @media (max-width: 48rem) {
    .services > li { grid-template-columns: 3rem minmax(0, 1fr); }
    .services-detail { grid-column: 2; }
  }

  /* Boîte à outils : catégorie en italique à gauche, outils à droite. */
  .outils { margin: 0; border-top: 1px solid color-mix(in srgb, var(--encre) 30%, transparent); }
  .outils > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: center;
    gap: 1rem 2rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid color-mix(in srgb, var(--encre) 30%, transparent);
  }
  .outils dt { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.1; }
  .outils dd { margin: 0; }
  .outils .etiquettes > * { font-size: var(--t-corps); padding: 0.45rem 0.9rem; }
  .outil-nombre { font-size: var(--t-legende); color: var(--encre-douce); }
  @media (max-width: 40rem) {
    .outils > div { grid-template-columns: 1fr; }
  }

  /* Les outils se posent un à un. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .outils .etiquettes > li { animation: outil-pose linear both; }
      .outils ul.etiquettes > li { animation-timeline: view(); animation-range: entry calc(var(--i) * 12%) entry calc(50% + var(--i) * 12%); }
      /* Services : le numéro et le nom arrivent de part et d'autre de leur ligne. */
      .services-numero { animation: service-numero linear both; }
      .services > li > .services-numero { animation-timeline: view(); animation-range: entry 0% entry 90%; }
      .services h3 { animation: service-nom linear both; }
      .services > li > h3 { animation-timeline: view(); animation-range: entry 0% entry 90%; }
    }
  }
  @keyframes outil-pose { from { opacity: 0; scale: 0.8; translate: 0 0.75rem; } to { opacity: 1; scale: 1; translate: 0 0; } }
  @keyframes service-numero { from { translate: -1.5rem 0; opacity: 0; } to { translate: 0 0; opacity: 1; } }
  @keyframes service-nom { from { translate: 2.5rem 0; } to { translate: 0 0; } }
  @media (hover: hover) and (pointer: fine) {
    .services > li { transition: background-color var(--duree) var(--courbe); }
    .services > li:hover { background: color-mix(in srgb, var(--encre) 6%, transparent); }
  }

  /* Parcours : par défaut une liste verticale ; frise horizontale au défilement si le navigateur le permet. */
  .frise { display: grid; margin: 0; padding: 0 var(--gouttiere); list-style: none; }
  .frise > li {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding-block: 1.5rem;
    border-top: 1px solid var(--bordure);
  }
  .frise-annee { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(3.5rem, 8vw, 7rem); line-height: 0.9; color: var(--marque); }
  .frise-periode { margin: 0; font-size: var(--t-legende); color: var(--encre-douce); font-variant-numeric: tabular-nums; }
  .frise h3 { font-size: var(--t-h3); max-width: 22ch; }
  .frise-collant { max-width: var(--largeur-max); margin-inline: auto; }
  @supports (animation-timeline: view()) {
    /* min-height : sur un écran bas (ou zoomé à 200 %), l'en-tête cacherait le haut de la frise collante ; on garde la liste. */
    @media (prefers-reduced-motion: no-preference) and (min-width: 48rem) and (min-height: 44rem) {
      /* La section dure un écran de plus par affiche environ ; son contenu reste collé pendant ce temps. */
      /* view-timeline-inset: 0 : sinon le scroll-padding-top global (5rem) décale le départ de la frise. */
      .chapitre--frise { height: calc(100svh + var(--n) * 18rem); padding-block: 0; view-timeline: --frise block; view-timeline-inset: 0; }
      .frise-collant {
        position: sticky;
        top: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100svh;
        max-width: none;
        overflow: hidden;
      }
      .frise { display: flex; width: max-content; gap: clamp(2.5rem, 5vw, 5rem); animation: frise linear both; }
      /* Règle séparée : le minifieur fusionnerait sinon la timeline dans le raccourci « animation ». */
      .frise-collant > ol.frise { animation-timeline: --frise; animation-range: contain 0% contain 100%; }
      .frise > li { width: 20rem; }
      /* Le fil se retrouve ici à l'horizontale : il avance avec les années. */
      .frise-collant::after {
        content: '';
        position: absolute;
        inset: auto 0 clamp(2rem, 8svh, 5rem);
        height: 2px;
        background: var(--marque);
        transform-origin: left;
        animation: frise-trace linear both;
      }
      div.frise-collant::after { animation-timeline: --frise; animation-range: contain 0% contain 100%; }
    }
    /* Liste verticale (téléphone, écran bas) : chaque étape arrive à son tour. */
    @media (prefers-reduced-motion: no-preference) and ((max-width: 47.99rem) or (max-height: 43.99rem)) {
      .frise > li { animation: etape-entree linear both; }
      ol.frise > li { animation-timeline: view(); animation-range: entry 0% entry 70%; }
    }
  }
  @keyframes frise-trace { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes etape-entree { from { opacity: 0; translate: 0 1.5rem; } to { opacity: 1; translate: 0 0; } }
  @keyframes frise { to { translate: calc(-100% + 100vw) 0; } }

  /* Arrivée des chapitres colorés : le bloc s'élargit jusqu'aux bords en entrant à l'écran. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .chapitre--papier,
      .chapitre--accent { animation: ouverture linear both; }
      section.chapitre--papier,
      section.chapitre--accent { animation-timeline: view(); animation-range: entry 0% entry 70%; }
    }
  }
  @keyframes ouverture { from { clip-path: inset(0 4% round 1.5rem); } to { clip-path: inset(0 0 round 0); } }

  /* ---------- Réalisé pour ---------- */
  .realise { margin: 0; padding: 0; list-style: none; border-top: 1px solid color-mix(in srgb, var(--encre) 25%, transparent); }
  .realise > li { border-bottom: 1px solid color-mix(in srgb, var(--encre) 25%, transparent); }
  .realise a, .realise div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
  }
  .realise-nom { font-family: var(--police-titre); font-size: clamp(1.5rem, 3.4vw, 3rem); line-height: 1.05; text-transform: uppercase; }
  .realise-detail { font-size: var(--t-legende); color: var(--encre-douce); }
  .realise a { transition: padding-inline-start var(--duree) var(--courbe); }
  .realise a:hover, .realise a:focus-visible { padding-inline-start: 1rem; }
  .realise a:hover .realise-nom { color: var(--marque); }
  @media (max-width: 40rem) {
    .realise a, .realise div { grid-template-columns: 1fr; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .realise > li { animation: etape-entree linear both; }
      ul.realise > li { animation-timeline: view(); animation-range: entry 0% entry 80%; }
    }
  }

  /* ---------- Index : toute la production, avec un aperçu au survol ---------- */
  .index { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .index-groupes { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .index-origine { display: flex; justify-content: space-between; padding-bottom: 0.75rem; font-size: var(--t-h3); }
  .index-origine span { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--marque); }
  .index-groupes ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--bordure-forte); }
  .index-groupes li { border-bottom: 1px solid var(--bordure); break-inside: avoid; }
  @media (min-width: 72rem) {
    .index-groupes ul { columns: 2; column-gap: clamp(1.5rem, 3vw, 3rem); }
  }
  .index-groupes a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    min-height: 44px;
    padding-block: 0.7rem;
    transition: color var(--duree) var(--courbe), padding-inline-start var(--duree) var(--courbe);
  }
  .index-groupes a:hover, .index-groupes a:focus-visible { color: var(--accent); padding-inline-start: 0.75rem; }
  .index-annee { font-size: var(--t-legende); color: var(--texte-doux); font-variant-numeric: tabular-nums; }
  .index-apercu { position: sticky; top: 6rem; aspect-ratio: 3 / 4; overflow: hidden; background: var(--surface); }
  .index-apercu img { width: 100%; height: 100%; object-fit: cover; }
  /* Sans souris, pas d'aperçu : il resterait figé sur la première affiche. */
  @media (max-width: 56rem), (hover: none) {
    .index { grid-template-columns: 1fr; }
    .index-apercu { display: none; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .index-groupes li { animation: etape-entree linear both; }
      .index-groupes ul > li { animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }

  /* ---------- Appel à contact ---------- */
  .cta {
    position: relative;
    margin-top: var(--section);
    padding-block: clamp(4rem, 9vw, 8rem) clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--bordure);
    /* Halo d'accent qui s'éteint avant les bords de la section (pas de coupure nette). */
    background: radial-gradient(45% 55% at 12% 70%, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
  }
  .cta-interne { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .cta-titre { font-size: clamp(3.5rem, 11.5vw, 11rem); }
  .cta-bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 3rem;
  }

  /* Le titre final grandit jusqu'à sa pleine taille : le fil arrive au bout de la page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cta-titre { transform-origin: left bottom; animation: cta-grandit linear both; }
      h2.cta-titre { animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }
  @keyframes cta-grandit { from { scale: 0.72; } to { scale: 1; } }

  /* Bouton pause : icône seule (libellé pour les lecteurs d'écran), dans le coin bas du mur, cible 44 px. */
  .hero { position: relative; }
  .pause-anim {
    position: absolute;
    right: calc(var(--gouttiere) + 0.5rem);
    bottom: calc(clamp(3rem, 6vw, 6rem) + 0.75rem);
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--bordure-forte);
    border-radius: 2px;
    background: var(--fond);
    color: var(--texte-doux);
    cursor: pointer;
    transition: color var(--duree) var(--courbe), border-color var(--duree) var(--courbe);
  }
  .pause-anim[hidden] { display: none; }
  .pause-anim:hover { color: var(--texte); border-color: var(--accent); }
  /* Icône dessinée en CSS : deux barres (pause), un triangle (lecture). */
  .icone {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
  }
  .en-pause .icone {
    border: 0;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .en-pause .piste,
  .en-pause .pastille { animation-play-state: paused; }
  @media (max-width: 48rem) {
    .pause-anim { position: static; justify-self: end; margin-top: -1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pastille { animation: none; }
    /* Sans animation : les trois mots côte à côte, le doublon de fin masqué. */
    .mots-fenetre { height: auto; }
    .mots-piste { flex-direction: row; flex-wrap: wrap; gap: 0 0.75rem; animation: none; }
    .mots-piste em:last-child { display: none; }
    .pause-anim { display: none; }
  }
</style>

<script>
  import { lancerFumee } from '../scripts/fumee.js';
  const pauseFumee = lancerFumee(document.querySelector('.fumee'));

  // Pause / lecture de tout ce qui bouge dans le hero. Le libellé change, donc pas d'aria-pressed (motif APG).
  const scene = document.querySelector('.hero-scene');
  const bouton = document.querySelector('.pause-anim');
  if (scene && bouton) {
    bouton.hidden = false;
    bouton.addEventListener('click', () => {
      const pause = scene.classList.toggle('en-pause');
      bouton.querySelector('.libelle').textContent = pause ? bouton.dataset.lecture : bouton.dataset.pause;
      pauseFumee?.(pause);
    });
  }

  // Fil conducteur : le nom de la section au milieu de l'écran, et le fond sur lequel passe le fil.
  const fil = document.querySelector('.fil');
  const libelle = fil?.querySelector('.fil-libelle');
  const etapes = [...document.querySelectorAll('[data-fil]')];
  const nommees = etapes.filter((e) => e.dataset.fil);
  if (fil && etapes.length) {
    const suivi = new IntersectionObserver((entrees) => {
      for (const { isIntersecting, target } of entrees) {
        if (!isIntersecting) continue;
        const rang = nommees.indexOf(target);
        libelle.textContent = rang < 0 ? '' : `${String(rang + 1).padStart(2, '0')} — ${target.dataset.fil}`;
        fil.dataset.fond = target.classList.contains('chapitre--papier') ? 'papier' : target.classList.contains('chapitre--accent') ? 'accent' : '';
      }
    }, { rootMargin: '-50% 0px -50% 0px' });
    etapes.forEach((e) => suivi.observe(e));
  }

  // Index : l'affiche du projet survolé ou atteint au clavier.
  const apercu = document.querySelector('.index-apercu img');
  document.querySelectorAll('.index-groupes a').forEach((lien) => {
    const montrer = () => {
      if (!apercu || apercu.getAttribute('src') === lien.dataset.src) return;
      apercu.srcset = lien.dataset.srcset;
      apercu.src = lien.dataset.src;
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) apercu.animate([{ opacity: 0.2, scale: 1.04 }, { opacity: 1, scale: 1 }], { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)' });
    };
    lien.addEventListener('pointerenter', montrer);
    lien.addEventListener('focus', montrer);
  });

  // Le mur d'affiches s'arrête quand il sort de l'écran : aucun calcul pour un décor invisible.
  const mur = document.querySelector('.mur');
  if (mur) new IntersectionObserver(([e]) => mur.classList.toggle('hors-champ', !e.isIntersecting)).observe(mur);
</script>
