---
import Base from '../layouts/Base.astro';
import Fil from '../components/Fil.astro';
import { traduire, route, champ, autreLangue } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const c = r.contact;
const reseaux = [
  c.instagram && { nom: 'Instagram', url: c.instagram },
  c.linkedin && { nom: 'LinkedIn', url: c.linkedin },
].filter(Boolean);
---

<Base titre={t('contact.titre')} description={t('contact.chapeau')} equivalent={route(autreLangue(langue), 'contact')}>
    <Fil />
    <section class="enveloppe hero sortie-hero" data-fil="">
      <p class="eyebrow reveal reveal--eyebrow">{champ(r.hero, 'eyebrow', langue)}</p>
      <h1 class="hero-titre titre-masque reveal">
        <span class="ligne"><span>{t('contact.titre')},</span></span>{' '}
        <span class="ligne ligne-chute"><span><em>{t('contact.chute')}</em></span></span>
      </h1>
      <p class="chapeau reveal reveal--eyebrow">{t('contact.chapeau')}</p>
    </section>

    <section class="chapitre chapitre--papier" data-fil={t('contact.titre')}>
      <div class="enveloppe">
        <div class="entete-chapitre reveal reveal--bloc">
          <p class="eyebrow">{t('contact.surtitre')}</p>
          <h2 class="titre-chapitre">{t('contact.bloc.titre')} <em>{t('contact.bloc.chute')}</em></h2>
        </div>
        <ul class="rangs">
          <li><a href={`mailto:${c.email}`}><span class="rang-nom adresse">{c.email}</span><span class="rang-detail">{t('contact.email')} <span aria-hidden="true">&rarr;</span></span></a></li>
          {reseaux.map((x) => (
            <li><a href={x.url} rel="me noopener" target="_blank"><span class="rang-nom">{x.nom}</span><span class="rang-detail">{t('contact.reseaux')} <span aria-hidden="true">&nearr;</span><span class="sr-only"> {t('a11y.nouvelOnglet')}</span></span></a></li>
          ))}
        </ul>
      </div>
    </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(3rem, 6vw, 6.25rem) 0;
  }
  /* L'adresse garde sa casse et peut se couper : elle doit rester copiable et tenir sur un téléphone. */
  .adresse { text-transform: none; overflow-wrap: anywhere; }
</style>
