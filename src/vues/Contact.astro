---
import Base from '../layouts/Base.astro';
import { traduire, route, autreLangue } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const c = r.contact;
const reseaux = [
  c.instagram && { nom: 'Instagram', url: c.instagram },
  c.linkedin && { nom: 'LinkedIn', url: c.linkedin },
].filter(Boolean);
---

<Base titre={t('contact.titre')} description={t('contact.chapeau')} equivalent={route(autreLangue(langue), 'contact')}>
    <section class="enveloppe hero">
      <h1 class="hero-titre titre-masque reveal"><span class="ligne"><span>{t('contact.titre')}</span></span></h1>
      <p class="chapeau reveal reveal--eyebrow">{t('contact.chapeau')}</p>
    </section>

    <section class="enveloppe blocs">
      <div class="reveal reveal--bloc">
        <p class="eyebrow">{t('contact.email')}</p>
        <a class="adresse" href={`mailto:${c.email}`}>{c.email}</a>
      </div>
      {reseaux.length > 0 && (
        <div class="reveal reveal--bloc">
          <p class="eyebrow">{t('contact.reseaux')}</p>
          <ul class="liens">
            {reseaux.map((r2) => (
              <li><a class="lien-accent" href={r2.url} rel="me noopener" target="_blank">{r2.nom}<span class="sr-only"> {t('a11y.nouvelOnglet')}</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(3rem, 6vw, 6.25rem) 2rem;
  }
  .blocs {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2.5rem;
    border-top: 1px solid var(--bordure);
    padding-top: 2.5rem;
  }
  .adresse {
    display: inline-block;
    margin-top: 1rem;
    font-size: clamp(1.5rem, 4.6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--bordure-forte);
    transition: color var(--duree) var(--courbe), border-color var(--duree) var(--courbe);
  }
  .adresse:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 48rem) { .blocs { grid-template-columns: 1fr; } }
  .liens { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
</style>
