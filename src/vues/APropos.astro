---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { traduire, route, champ, autreLangue } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';
import { personne } from '../lib/schema.js';
import { dimensions, srcsetVignette } from '../lib/images.js';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const schema = { '@context': 'https://schema.org', ...personne(r, t('schema.metier'), Astro.site) };
const a = r.apropos;
const bio = champ(a, 'bio', langue);
// Le bouton CV n'apparaît que si public/cv-sharn.pdf existe.
const cvDispo = existsSync('public/cv-sharn.pdf');
// Photo facultative (champ vide dans l'admin = pas de photo).
const photo = a.photo ? { src: a.photo, ...(await dimensions(a.photo)), srcset: await srcsetVignette(a.photo) } : null;
---

<Base titre={t('apropos.titre')} description={t('apropos.description')} equivalent={route(autreLangue(langue), 'apropos')} schema={schema}>
    <section class="enveloppe hero">
      <h1 class="hero-titre titre-masque reveal"><span class="ligne"><span>{t('apropos.titre')}</span></span></h1>
    </section>

    <section class="enveloppe contenu">
      <div class="bio reveal reveal--bloc">
        {bio.map((p) => <p>{p}</p>)}
        {cvDispo && <a class="bouton" href="/cv-sharn.pdf" download>{t('apropos.cv')}</a>}
        {photo && (
          <img class="photo" src={photo.src} srcset={photo.srcset} sizes="(max-width: 48rem) 20rem, 24rem" alt={t('apropos.photo')} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
        )}
      </div>

      <div class="colonnes">
        <section class="reveal reveal--bloc">
          <p class="eyebrow">{t('apropos.parcours')}</p>
          <ul class="liste">
            {a.parcours.map((item) => (
              <li>
                <span class="periode">{item.periode}</span>
                <span class="intitule">{champ(item, 'titre', langue)}</span>
                <span class="legende">{champ(item, 'lieu', langue)}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="reveal reveal--bloc">
          <p class="eyebrow">{t('apropos.competences')}</p>
          <ul class="liste">
            {a.competences.map((item) => (
              <li>
                <span class="intitule">{champ(item, 'groupe', langue)}</span>
                <span class="legende">{item.outils}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 6vw, 6.25rem) 2rem; }
  .contenu {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }
  .photo {
    display: block;
    margin-top: 1rem;
    width: 100%;
    max-width: 24rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  @media (max-width: 48rem) {
    .contenu { grid-template-columns: 1fr; }
    .photo { max-width: 20rem; }
  }
  .bio p { color: var(--texte-doux); max-width: 60ch; margin: 0 0 1.5rem; }
  .bio .bouton { margin-top: 0.5rem; }
  .colonnes section + section { margin-top: 3rem; }
  .liste {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--bordure);
  }
  .liste li {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--bordure);
  }
  .periode { font-size: var(--t-legende); color: var(--accent); }
  .intitule { font-size: 0.9375rem; font-weight: 500; }
</style>
