---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Fil from '../components/Fil.astro';
import BlocApropos from '../components/BlocApropos.astro';
import ChapitreOutils from '../components/ChapitreOutils.astro';
import ChapitreParcours from '../components/ChapitreParcours.astro';
import AppelContact from '../components/AppelContact.astro';
import { traduire, route, champ, autreLangue } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';
import { personne } from '../lib/schema.js';

const { langue } = Astro.props;
const t = traduire(langue);
const r = await lireReglages();
const schema = { '@context': 'https://schema.org', ...personne(r, t('schema.metier'), Astro.site) };
// Le bouton CV n'apparaît que si public/cv-sharn.pdf existe.
const cvDispo = existsSync('public/cv-sharn.pdf');
---

<Base titre={t('apropos.titre')} description={t('apropos.description')} equivalent={route(autreLangue(langue), 'apropos')} schema={schema}>
    <Fil />
    <section class="enveloppe hero sortie-hero" data-fil="">
      <p class="eyebrow reveal reveal--eyebrow">{champ(r.hero, 'eyebrow', langue)}</p>
      <h1 class="hero-titre titre-masque reveal">
        <span class="ligne"><span>{t('accueil.apropos.titre')}</span></span>{' '}
        <span class="ligne ligne-chute"><span><em>{t('accueil.apropos.chute')}</em></span></span>
      </h1>
    </section>

    <BlocApropos langue={langue} avecTitre={false} avecLien={false}>
      {cvDispo && <a class="bouton reveal reveal--bloc" href="/cv-sharn.pdf" download>{t('apropos.cv')}</a>}
    </BlocApropos>
    <ChapitreOutils langue={langue} />
    <ChapitreParcours langue={langue} />
    <AppelContact langue={langue} />
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(3rem, 6vw, 6.25rem) 0;
  }
</style>
