---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langueDepuisUrl, traduire } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';
import policeInter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import policeAnton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';

// image : chemin d'une image de partage (1200 px). schema : objet schema.org à publier en JSON-LD.
const {
  titre,
  description,
  equivalent,
  image,
  imageLargeur = 1200,
  imageHauteur = 630,
  schema,
  indexer = true,
  preloads = [],
} = Astro.props;
const langue = langueDepuisUrl(Astro.url);
const t = traduire(langue);
// Carte de partage par défaut dans la langue de la page (modèle : scripts/carte-partage.html).
const imagePartage = image ?? (langue === 'en' ? '/og-default-en.png' : '/og-default.png');
const canonique = new URL(Astro.url.pathname, Astro.site);
const urlAutre = equivalent && new URL(equivalent, Astro.site);
const urlFr = langue === 'fr' ? canonique : urlAutre;
const { theme } = await lireReglages();
// « < » échappé : un titre saisi dans l'admin ne peut pas fermer la balise <script>.
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={langue} style={`--accent:${theme.accent}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    {/* Signale que le JS tourne : sans lui, les blocs .reveal restent visibles. Le choix des lumières
        s'applique ici, avant le premier rendu, pour éviter un éclair sombre à chaque page. */}
    {/* Son empreinte CSP est écrite à la main dans astro.config.mjs : à recalculer s'il change. */}
    <script is:inline>document.documentElement.classList.add('js');try{if(localStorage.getItem('salle')==='allumee'){document.documentElement.dataset.salle='allumee';document.querySelector('meta[name="theme-color"]').content='#f7f4ee'}}catch(e){}</script>
    <title>{titre} — Shar'N</title>
    <meta name="description" content={description} />
    {!indexer && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonique} />
    <link rel="preload" href={policeInter} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeAnton} as="font" type="font/woff2" crossorigin />
    {preloads.map((p) => <link rel="preload" href={p} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:site_name" content="Shar'N" />
    <meta property="og:title" content={`${titre} — Shar'N`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content={langue === 'fr' ? 'fr_BE' : 'en_US'} />
    <meta property="og:image" content={new URL(imagePartage, Astro.site)} />
    <meta property="og:image:width" content={String(imageLargeur)} />
    <meta property="og:image:height" content={String(imageHauteur)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {urlAutre && (
      <>
        <link rel="alternate" hreflang={langue} href={canonique} />
        <link rel="alternate" hreflang={langue === 'fr' ? 'en' : 'fr'} href={urlAutre} />
        <link rel="alternate" hreflang="x-default" href={urlFr} />
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>

  <body data-entracte={t('onglet.entracte')} data-reprise={t('onglet.reprise')}>
    <a class="saut-contenu" href="#contenu">{t('a11y.saut')}</a>
    <Header langue={langue} equivalent={equivalent} />
    <main id="contenu"><slot /></main>
    <Footer langue={langue} />
    {/* Pastille « Voir » qui accompagne la souris sur les affiches : décor, le lien reste le vrai contrôle. */}
    <div class="curseur-voir" aria-hidden="true">{t('carte.voir')}</div>

    <script>
      // Titre de l'onglet : « entracte » quand on part, « reprise » 2 s au retour.
      const titreNormal = document.title;
      let minuteurTitre = 0;
      document.addEventListener('visibilitychange', () => {
        clearTimeout(minuteurTitre);
        document.title = document.hidden ? document.body.dataset.entracte : document.body.dataset.reprise;
        if (!document.hidden) minuteurTitre = setTimeout(() => (document.title = titreNormal), 2000);
      });

      const cibles = document.querySelectorAll('.reveal');
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Lumières de la salle : fondu entre les deux thèmes, instantané si les animations sont réduites.
      const racine = document.documentElement;
      const interrupteurs = document.querySelectorAll('.interrupteur');
      const marquer = () => interrupteurs.forEach((b) => b.setAttribute('aria-pressed', String(racine.dataset.salle === 'allumee')));
      marquer();
      interrupteurs.forEach((b) => b.addEventListener('click', () => {
        const allumee = racine.dataset.salle !== 'allumee';
        const basculer = () => {
          if (allumee) racine.dataset.salle = 'allumee';
          else delete racine.dataset.salle;
          document.querySelector('meta[name="theme-color"]').content = getComputedStyle(racine).getPropertyValue('--fond').trim();
          marquer();
        };
        try { localStorage.setItem('salle', allumee ? 'allumee' : 'eteinte'); } catch {}
        if (document.startViewTransition && !reduit) document.startViewTransition(basculer);
        else basculer();
      }));

      if (reduit) {
        cibles.forEach((el) => el.classList.add('visible'));
      } else {
        // Le hero apparaît au chargement, comme la timeline Figma
        document.querySelectorAll('.hero .reveal, .entete.reveal').forEach((el) => {
          requestAnimationFrame(() => el.classList.add('visible'));
        });

        const obs = new IntersectionObserver(
          (entrees) => {
            entrees.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px' }
        );

        cibles.forEach((el) => {
          if (!el.classList.contains('visible')) obs.observe(el);
        });

        // Inclinaison 3D des vignettes : souris uniquement, 6° max.
        if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
          document.querySelectorAll('.carte-visuel').forEach((v) => {
            v.addEventListener('pointermove', (e) => {
              const r = v.getBoundingClientRect();
              const x = (e.clientX - r.left) / r.width;
              const y = (e.clientY - r.top) / r.height;
              v.classList.add('incline');
              v.style.setProperty('--ry', `${((x - 0.5) * 12).toFixed(2)}deg`);
              v.style.setProperty('--rx', `${((0.5 - y) * 12).toFixed(2)}deg`);
              v.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
              v.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
            });
            v.addEventListener('pointerleave', () => {
              v.classList.remove('incline');
              v.style.setProperty('--rx', '0deg');
              v.style.setProperty('--ry', '0deg');
            });
          });

          // Pastille « Voir » : suit la souris sur les affiches, avec le même amorti que l'aperçu de l'Index.
          const pastille = document.querySelector('.curseur-voir');
          const affiches = document.querySelectorAll('.carte .carte-visuel');
          if (pastille && affiches.length) {
            let cx = 0, cy = 0, x = 0, y = 0, boucle = 0;
            const suivre = () => {
              x += (cx - x) * 0.18;
              y += (cy - y) * 0.18;
              pastille.style.setProperty('--x', `${x.toFixed(1)}px`);
              pastille.style.setProperty('--y', `${y.toFixed(1)}px`);
              boucle = Math.abs(cx - x) + Math.abs(cy - y) > 0.5 ? requestAnimationFrame(suivre) : 0;
            };
            affiches.forEach((v) => {
              v.addEventListener('pointerenter', (e) => {
                // Première apparition : la pastille part de la souris, pas du coin de l'écran.
                if (!pastille.classList.contains('visible')) { x = e.clientX; y = e.clientY; }
                pastille.classList.add('visible');
              });
              v.addEventListener('pointermove', (e) => {
                cx = e.clientX;
                cy = e.clientY;
                if (!boucle) boucle = requestAnimationFrame(suivre);
              });
              v.addEventListener('pointerleave', () => pastille.classList.remove('visible'));
            });
            // Clic, changement de page ou défilement hors de l'affiche : la pastille ne reste pas en l'air.
            addEventListener('scroll', () => pastille.classList.remove('visible'), { passive: true });
          }

          // Boutons magnétiques : suivent la souris de 30 % de l'écart, 10 px au plus, puis reviennent en ressort.
          document.querySelectorAll('.bouton').forEach((b) => {
            b.addEventListener('pointermove', (e) => {
              const r = b.getBoundingClientRect();
              const borne = (v) => Math.max(-10, Math.min(10, v * 0.3));
              b.style.setProperty('--tx', `${borne(e.clientX - r.left - r.width / 2).toFixed(1)}px`);
              b.style.setProperty('--ty', `${borne(e.clientY - r.top - r.height / 2).toFixed(1)}px`);
            });
            b.addEventListener('pointerleave', () => {
              b.style.setProperty('--tx', '0px');
              b.style.setProperty('--ty', '0px');
            });
          });
        }
      }
    </script>
  </body>
</html>
