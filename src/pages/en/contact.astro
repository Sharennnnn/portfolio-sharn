---
import Base from '../../layouts/Base.astro';
import { traduire } from '../../i18n/utils.js';
import { lireReglages } from '../../i18n/reglages.js';

const langue = 'en';
const t = traduire(langue);
const r = await lireReglages();
const c = r.contact;
const style = `--accent:${r.theme.accent}`;
const reseaux = [
  c.instagram && { nom: 'Instagram', url: c.instagram },
  c.linkedin && { nom: 'LinkedIn', url: c.linkedin },
].filter(Boolean);
---

<Base titre={t('contact.titre')} description={t('contact.chapeau')} equivalent="/contact">
  <div style={style}>
    <section class="enveloppe hero">
      <h1 class="hero-titre reveal reveal--titre">{t('contact.titre')}</h1>
      <p class="chapeau reveal reveal--eyebrow">{t('contact.chapeau')}</p>
    </section>

    <section class="enveloppe blocs">
      <div class="reveal reveal--bloc">
        <p class="eyebrow">{t('contact.email')}</p>
        <a class="adresse" href={`mailto:${c.email}`}>{c.email}</a>
      </div>
      {reseaux.length > 0 && (
        <div class="reveal reveal--bloc">
          <p class="eyebrow">{t('contact.reseaux')}</p>
          <ul class="liens">
            {reseaux.map((r2) => (
              <li><a class="lien-accent" href={r2.url} rel="me noopener" target="_blank">{r2.nom}</a></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(3rem, 6vw, 6.25rem) 2rem;
  }
  .blocs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 2.5rem;
    border-top: 1px solid var(--bordure);
    padding-top: 2.5rem;
  }
  .adresse {
    display: inline-block;
    margin-top: 1rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--bordure-forte);
    transition: color var(--duree) var(--courbe), border-color var(--duree) var(--courbe);
  }
  .adresse:hover { color: var(--accent); border-color: var(--accent); }
  .liens { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
</style>
