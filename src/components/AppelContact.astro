---
// Appel à contact : la fin de page commune.
import { traduire, route, champ } from '../i18n/utils.js';
import { lireReglages } from '../i18n/reglages.js';

const { langue } = Astro.props;
const t = traduire(langue);
const h = (await lireReglages()).hero;
---

<section class="cta" data-fil={t('accueil.fil.cta')}>
  <div class="enveloppe cta-interne">
    <h2 class="cta-titre titre-masque reveal"><span class="ligne"><span>{champ(h, 'cta_titre', langue)}</span></span></h2>
    <div class="cta-bas reveal reveal--cta">
      <p class="chapeau">{champ(h, 'cta_texte', langue)}</p>
      <a class="bouton bouton--plein" href={route(langue, 'contact')}>{champ(h, 'cta_bouton', langue)} <span class="fleche" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  /* ---------- Appel à contact ---------- */
  .cta {
    position: relative;
    margin-top: var(--section);
    padding-block: clamp(4rem, 9vw, 8rem) clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--bordure);
    /* Halo d'accent qui s'éteint avant les bords de la section (pas de coupure nette). */
    background: radial-gradient(45% 55% at 12% 70%, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
  }
  .cta-interne { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .cta-titre { font-size: clamp(3.5rem, 11.5vw, 11rem); }
  .cta-bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 3rem;
  }

  /* Le titre final grandit jusqu'à sa pleine taille : le fil arrive au bout de la page. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cta-titre { transform-origin: left bottom; animation: cta-grandit linear both; }
      h2.cta-titre { animation-timeline: view(); animation-range: entry 0% entry 100%; }
    }
  }
  @keyframes cta-grandit { from { scale: 0.72; } to { scale: 1; } }
</style>
