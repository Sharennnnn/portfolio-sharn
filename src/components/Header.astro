---
import { traduire, route } from '../i18n/utils.js';
const { langue, equivalent } = Astro.props;
const t = traduire(langue);
const autre = langue === 'fr' ? 'en' : 'fr';
const lienAutre = equivalent ?? route(autre, 'accueil');
const chemin = Astro.url.pathname;
const liens = ['projets', 'apropos', 'contact'].map((nom) => ({
  nom,
  href: route(langue, nom),
  // Une page projet (/projets/creed/) appartient à la rubrique Projets.
  actif: chemin.startsWith(route(langue, nom)),
}));
---

<header class="entete reveal reveal--header" style="view-transition-name: entete">
  <div class="ilot">
    <a class="marque" href={route(langue, 'accueil')}>Shar<span class="apostrophe">&rsquo;</span>N</a>
    <nav class="nav" aria-label={t('a11y.nav')}>
      {liens.map((l) => (
        <a href={l.href} aria-current={l.actif ? 'page' : undefined}>{t(`nav.${l.nom}`)}</a>
      ))}
      <a class="langue" href={lienAutre} hreflang={autre} aria-label={`${autre.toUpperCase()}, ${t('a11y.langue')}`}>
        {autre.toUpperCase()}
      </a>
    </nav>
  </div>
</header>

<style>
  /* Îlot flottant : détaché du bord, translucide (le flou ne s'applique qu'à cet élément fixe). */
  .entete {
    position: sticky;
    top: 0;
    z-index: var(--z-entete);
    padding: 0.75rem var(--gouttiere) 0;
    pointer-events: none;
  }
  .ilot {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--largeur-max) - 2 * var(--gouttiere));
    height: 52px;
    margin-inline: auto;
    padding-inline: 1.25rem 0.5rem;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--texte) 9%, transparent);
    border-radius: 4px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--texte) 6%, transparent), 0 12px 32px -18px rgb(0 0 0 / 0.8);
  }
  .marque {
    font-size: 1.0625rem;
    font-weight: 780;
    letter-spacing: -0.045em;
  }
  .apostrophe { color: var(--accent); }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.2vw, 0.75rem);
    font-size: var(--t-legende);
  }
  .nav a:not(.langue) {
    position: relative;
    padding: 0.5rem 0.75rem;
    color: var(--texte-doux);
    transition: color var(--duree) var(--courbe);
  }
  .nav a:not(.langue):hover { color: var(--texte); }
  /* Page en cours : texte clair et point d'accent sous le lien. */
  .nav a[aria-current='page'] { color: var(--texte); }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }
  .langue {
    margin-left: 0.25rem;
    padding: 0.375rem 0.6rem;
    border: 1px solid var(--bordure-forte);
    border-radius: 2px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--texte-doux);
    transition: border-color var(--duree) var(--courbe), color var(--duree) var(--courbe);
  }
  .langue:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 40rem) {
    .ilot { padding-inline: 0.875rem 0.375rem; }
    .nav a:not(.langue) { padding-inline: 0.5rem; }
  }
  /* Très petits écrans (320 px, WCAG 1.4.10) : « À propos » passait à la ligne et l'îlot débordait
     de 22 px. On resserre les espacements, pas le texte ; les cibles gardent ≥ 24 px de large. */
  .nav a { white-space: nowrap; }
  @media (max-width: 23rem) {
    .entete { padding-inline: 0.75rem; }
    .ilot { gap: 0.5rem; padding-inline: 0.625rem 0.25rem; }
    .nav { gap: 0; }
    .nav a:not(.langue) { padding-inline: 0.3rem; }
    .langue { margin-left: 0.125rem; }
  }
</style>
