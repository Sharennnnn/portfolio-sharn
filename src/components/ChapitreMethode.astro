---
// Comment je travaille : quatre étapes reliées par un trait qui se trace au défilement.
// Textes dans ui.js (FR et EN) : pas de case dans l'admin.
import { traduire } from '../i18n/utils.js';
import TitreChapitre from './TitreChapitre.astro';
const { langue } = Astro.props;
const t = traduire(langue);
const etapes = [1, 2, 3, 4].map((n) => ({ nom: t(`accueil.methode.${n}.nom`), texte: t(`accueil.methode.${n}.texte`) }));
---

<section class="chapitre" data-fil={t('accueil.fil.methode')}>
  <div class="enveloppe">
    <div class="entete-chapitre reveal reveal--bloc">
      <p class="eyebrow">{t('accueil.methode.surtitre')}</p>
      <TitreChapitre titre={t('accueil.methode.titre')} chute={t('accueil.methode.chute')} />
    </div>
    <ol class="methode">
      {etapes.map((e, i) => (
        <li style={`--i:${i}`}>
          <span class="methode-numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{e.nom}</h3>
          <p>{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Téléphone : étapes empilées, trait vertical à gauche. Écran large : quatre colonnes, trait horizontal. */
  .methode { position: relative; display: grid; gap: 2.5rem; margin: 0; padding: 0 0 0 1.75rem; list-style: none; }
  .methode::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    /* Trait discret en colonne : le fil conducteur orange passe déjà juste à côté, dans la marge. */
    background: color-mix(in srgb, var(--encre) 30%, transparent);
    transform-origin: top;
  }
  .methode > li { position: relative; display: grid; gap: 0.6rem; align-content: start; }
  /* Repère de l'étape, posé sur le trait. */
  .methode > li::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    left: calc(-1.75rem - 4.5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--marque);
  }
  .methode-numero { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1; color: var(--marque); }
  .methode h3 { font-size: clamp(1.5rem, 2.6vw, 2.25rem); }
  .methode p { margin: 0; color: var(--encre-douce); max-width: 34ch; }
  @media (min-width: 56rem) {
    .methode { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); padding: 2.25rem 0 0; }
    .methode::before { inset: 0 0 auto 0; width: auto; height: 2px; background: var(--marque); transform-origin: left; }
    .methode > li::before { top: calc(-2.25rem - 4px); left: 0; }
  }
  /* Au défilement : le trait se trace, puis chaque étape se pose à son tour. Sans support : tout est en place. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .methode::before { animation: methode-trait-y linear both; }
      .methode > li { animation: methode-etape linear both; }
      /* Règles séparées : le minifieur fusionnerait sinon la timeline dans le raccourci « animation », que Chrome rejette. */
      ol.methode::before { animation-timeline: view(); animation-range: entry 10% cover 55%; }
      ol.methode > li { animation-timeline: view(); animation-range: entry 0% entry 90%; }
      @media (min-width: 56rem) {
        .methode::before { animation-name: methode-trait-x; }
        /* Les quatre colonnes entrent ensemble à l'écran : chaque étape attend un peu plus que la précédente. */
        ol.methode > li { animation-range: entry calc(var(--i) * 25%) cover calc(22% + var(--i) * 9%); }
      }
    }
  }
  @keyframes methode-trait-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes methode-trait-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes methode-etape { from { opacity: 0; translate: 0 1.5rem; } to { opacity: 1; translate: 0 0; } }
</style>
