# En-têtes de sécurité, pour tout le site.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Admin : la fenêtre de connexion GitHub doit pouvoir répondre à la page (window.opener).
/admin/*
  ! Cross-Origin-Opener-Policy

# Fichiers versionnés par Astro (nom avec empreinte) : cache d'un an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images : cache d'une semaine, et aucun script exécutable si un fichier est ouvert directement.
/images/*
  Cache-Control: public, max-age=604800
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox
