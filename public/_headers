# En-têtes de sécurité, pour tout le site.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Admin : la fenêtre de connexion GitHub doit pouvoir répondre à la page (window.opener).
/admin/*
  ! Cross-Origin-Opener-Policy

# Fichiers versionnés par Astro (nom avec empreinte) : cache d'un an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images : aucun script exécutable si un fichier est ouvert directement.
/images/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox

# Cache des images, une règle par dossier : Cloudflare additionne les en-têtes de toutes les règles qui
# correspondent, un Cache-Control sur /images/* se cumulerait donc avec celui des vignettes.
# Originaux et images de partage : nom fixe (un remplacement garde l'adresse), cache d'une semaine.
/images/projets/*
  Cache-Control: public, max-age=604800
/images/partage/*
  Cache-Control: public, max-age=604800
# Vignettes : nom à empreinte du contenu (src/lib/images.js), donc immuables : cache d'un an.
/images/vignettes/*
  Cache-Control: public, max-age=31536000, immutable
